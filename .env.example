# ─────────────────────────────────────────────────────────────────────────────
# Agritech Swarm Intelligence Engine — Environment Variables
# Copy this file to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Bhashini Voice STT API (Government of India, MeitY ULCA / Dhruva)
# Register at: https://bhashini.gov.in/ulca/home
# ──────────────────────────────────────────────────────────────────────────────
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# ──────────────────────────────────────────────────────────────────────────────
# Data.gov.in Agmarknet APMC Mandi Price API
# Get free key at: https://data.gov.in/node/add/data-portal-api-access-request
# ──────────────────────────────────────────────────────────────────────────────
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4afd5208dbe48c4876b4

# ──────────────────────────────────────────────────────────────────────────────
# SQLite Database Paths (relative to project root)
# ──────────────────────────────────────────────────────────────────────────────
DB_PATH=artifacts/icar_knowledge.db
FAISS_INDEX_PATH=artifacts/icar_faiss.index
MANDI_DB_PATH=data/mandi_cache.db
VOICE_CACHE_DB_PATH=data/voice_cache.db

# ──────────────────────────────────────────────────────────────────────────────
# Agronomic Safety Thresholds (DO NOT CHANGE unless re-validating with ICAR)
# ──────────────────────────────────────────────────────────────────────────────
RAIN_LOCK_THRESHOLD_MM=10.0
WIND_LOCK_THRESHOLD_KMH=18.0
SOIL_MOISTURE_THRESHOLD=0.32
CONFIDENCE_GATE_TAU=0.60
HARVEST_THRESHOLD_PCT=5.0
API_TIMEOUT_SECONDS=3.0

